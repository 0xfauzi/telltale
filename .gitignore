# Credentials. Gitignored, never allowlisted in .gitleaks.toml: the staged secret scan has
# to keep watching this path, because `git add -f .env` is the commit the scan exists for.
.env
.DS_Store

# Environments and tool caches.
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
# `-p no:cacheprovider` in [tool.pytest.ini_options] stops our own runs writing this one.
# A run that does not read that config (an IDE runner, a different rootdir) still does.
.pytest_cache/
.ruff_cache/
.complexipy_cache/

# Working scratch. Also excluded from ruff and mypy, so a script left here cannot fail a
# local gate that a clean checkout would pass.
tmp/

# Raw experiment output: per-run captures, generated fixtures, timing dumps. Regenerated by
# the tracked runner in experiments/E##/run.py.
#
# THE CONCLUSION IS TRACKED AND THE RAW OUTPUT IS NOT. docs/experiments/E##.md is the
# decision file: the question, the rule written before the run, the numbers with units, and
# what may now be claimed. It cites files under experiments/E##/out/ by path, so an
# experiment that needs a specific artefact to survive re-includes exactly that file with a
# `!` line beneath this one, naming why it cannot be regenerated.
experiments/*/out/
# E07 re-includes its decision inputs, because they cannot be regenerated: the store they
# were computed from is the live capture database, which grows with every session this
# build runs, so a later `python experiments/E07/run.py` reads different rows and answers
# with different numbers. docs/experiments/E07.md cites these files by path.
!experiments/E07/out/
experiments/E07/out/*
!experiments/E07/out/summary.json
!experiments/E07/out/aggregates.json
!experiments/E07/out/cap_*/
!experiments/E07/out/pooled/
# The copied database. 40 MB of session records, regenerated by the runner in 0.04 s, and
# never committed by any code path here.
experiments/E07/out/home/

# E08 re-includes its decision inputs for E07's reason: the store it reads is the live
# capture database, which grew from 36 captures to 3223 between the two runs and grows
# with every session, so a later run answers with different numbers.
# census.json is NOT re-included: it holds one row per capture, 1.2 MB against the 500 KB
# check-added-large-files allows, and the counts docs/experiments/E08.md quotes from it
# are in summary.json.
!experiments/E08/out/
experiments/E08/out/*
!experiments/E08/out/summary.json
!experiments/E08/out/aggregates.json
!experiments/E08/out/survey.json
!experiments/E08/out/lineage.json
!experiments/E08/out/pilot.json
!experiments/E08/out/determinism.json
!experiments/E08/out/cap_*/
!experiments/E08/out/pooled/
# The copied database, 1.5 GB, never committed by any code path here.
experiments/E08/out/home/

# E08b re-includes its one output file. It is not regenerable in the sense the E08 lines
# describe (it is arithmetic over E08's tracked files and re-runs in under a second), but
# docs/experiments/E08b.md quotes every one of its 38 rows and the gate report cites the
# label counts, so the file the numbers came from is tracked beside the prose.
!experiments/E08b/out/
experiments/E08b/out/*
!experiments/E08b/out/summary.json

# E11 re-includes its decision inputs for E07's and E08's reason: the store it reads is
# the live capture database, which grows with every session this build runs, so a later
# `python experiments/E11/run.py` compiles a series with a different id from a different
# cohort. docs/experiments/E11.md cites these files by path and quotes every number in
# them. control/control.json is NOT re-included: it is 2.5 MB of scored windows against
# the 500 KB check-added-large-files allows, it is a control on the runner rather than
# evidence about anything, and the numbers the write-up quotes from it are reproducible
# by re-running the seeded synthetic series it scores.
!experiments/E11/out/
experiments/E11/out/*
!experiments/E11/out/summary.json
!experiments/E11/out/series.json
!experiments/E11/out/merge_verification_ms.json
!experiments/E11/out/merge_verification_failed.json
!experiments/E11/out/rework_within_3.json
!experiments/E11/out/run.log
# The copied database, 1.5 GB, never committed by any code path here.
experiments/E11/out/home/

# The capture database lives in $TELLTALE_HOME (default ~/.telltale/), outside the
# repository, so no ignore line can protect it. It holds sanitized session records and is
# never committed by any code path here.

# Claude Code agent worktrees are created inside the checkout by the orchestrator
# harness while a task runs and removed when it ends. Run state, not content.
.claude/worktrees/
